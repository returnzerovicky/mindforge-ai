# GEMINI_API_KEY: Required for Gemini AI API calls on the backend server.
# Never expose this key to the browser or VITE_* variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port for the Express API + frontend server (defaults to 3000)
PORT=3000

# REQUEST_TIMEOUT_MS: Server-side timeout for Gemini generation requests (milliseconds)
REQUEST_TIMEOUT_MS=60000

# RATE_LIMIT_MAX: Maximum generation requests per IP per 15-minute window
RATE_LIMIT_MAX=30

# CORS_ORIGIN: Allowed origin for CORS in standalone setups (comma-separated or * in dev)
CORS_ORIGIN=""

# APP_URL: Hosted URL of the application
APP_URL="MY_APP_URL"
